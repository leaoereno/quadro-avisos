{
    "manifest_version": 2.0,
    "id": "quadro_avisos",
    "name": "Quadro de Avisos",
    "version": "1.2.0",
    "namespace": "QuadroAvisos",
    "description": "Módulo de comunicados, requisições de mudança e eventos para equipes que utilizam o Zabbix. Permite cadastrar avisos com suporte a Markdown e HTML, agendamento de exibição, controle por grupo de usuários e visualização em cards temáticos. Desenvolvido por Rafael Leão.",
    "author": "Rafael Leão",
    "url": "https://github.com/leaoereno/quadro-avisos",
    "assets": {
        "css": ["quadro_avisos.css"]
    },
    "actions": {
        "quadro_avisos.dashboard": {
            "class": "CControllerQuadroAvisosDashboard",
            "view": "quadro.avisos.dashboard"
        },
        "quadro_avisos.view": {
            "class": "CControllerQuadroAvisosView",
            "view": "quadro.avisos.view"
        },
        "quadro_avisos.create": {
            "class": "CControllerQuadroAvisosCreate",
            "view": "quadro.avisos.create"
        },
        "quadro_avisos.edit": {
            "class": "CControllerQuadroAvisosEdit",
            "view": "quadro.avisos.create"
        },
        "quadro_avisos.save": {
            "class": "CControllerQuadroAvisosSave"
        },
        "quadro_avisos.delete": {
            "class": "CControllerQuadroAvisosDelete"
        }
    }
}
